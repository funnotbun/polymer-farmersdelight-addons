{
	"schemaVersion": 1,
	"id": "fd-unified-patch",
	"version": "${version}",
	"name": "FD Unified Polymer Patch",
	"description": "One unified Polymer patch for Farmer's Delight addon mods (v0.3: MoreDelight + RusticDelight + Farmer's Respite).",
	"authors": [
		"fd-unified-patch contributors"
	],
	"contact": {
		"sources": "https://github.com/axperty/moredelight"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.fdunified.patch.FdUnifiedPatch"
		]
	},
	"mixins": [
		"fd-unified-patch.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"farmersdelight": "*",
		"polymer-core": "0.17.3+26.2",
		"polymer-blocks": "0.17.3+26.2",
		"polymer-resource-pack": "0.17.3+26.2",
		"polymer-resource-pack-extras": "0.17.3+26.2",
		"polymer-virtual-entity": "0.17.3+26.2",
		"polymer-registry-sync-manipulator": "0.17.3+26.2",
		"sgui": "2.1.0+26.2"
	},
	"suggests": {
		"moredelight": "26.06.23-26.2-fabric",
		"delightlib": "26.06.23-26.2-fabric",
		"rusticdelight": "1.7.0",
		"farmersrespite": "2.3.1"
	}
}
