{
	"schemaVersion": 1,
	"id": "fd-unified-patch",
	"version": "${version}",
	"name": "FD Unified Polymer Patch",
	"description": "One unified Polymer patch for Farmer's Delight addon mods (v0.4: MoreDelight + RusticDelight + Farmer's Respite).",
	"authors": [
		"fd-unified-patch contributors"
	],
	"contact": {
		"sources": "https://github.com/axperty/moredelight"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.fdunified.patch.FdUnifiedPatch"
		]
	},
	"mixins": [
		"fd-unified-patch.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"farmersdelight": "*",
		"polymer-core": ">=0.18.0+26.3-rc-1",
		"polymer-blocks": ">=0.18.0+26.3-rc-1",
		"polymer-resource-pack": ">=0.18.0+26.3-rc-1",
		"polymer-resource-pack-extras": ">=0.18.0+26.3-rc-1",
		"polymer-virtual-entity": ">=0.18.0+26.3-rc-1",
		"polymer-registry-sync-manipulator": ">=0.18.0+26.3-rc-1",
		"sgui": ">=2.2.0+26.3"
	},
	"suggests": {
		"moredelight": "26.09.16-26.3-fabric",
		"delightlib": "26.09.16-26.3-fabric",
		"rusticdelight": "1.7.1-jf",
		"farmersrespite": "2.3.1"
	}
}
